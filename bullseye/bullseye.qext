{
  "name": "Bullseye",
  "description": "A part-to-whole ring chart in Qlik's standard look. One dimension gives a donut; several give concentric rings. Run the rings as a hierarchy (selecting an outer segment selects its whole path) or as independent layers.",
  "type": "visualization",
  "version": "1.0.0",
  "icon": "pie-chart",
  "author": "Benjamin Rode",
  "license": "MIT",
  "keywords": "qlik-visualization-extension",
  "dependencies": {
    "qlik-sense": ">=3.0.x"
  }
}
