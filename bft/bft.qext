{
  "name": "BFT",
  "description": "A part-to-whole ring chart. One dimension gives you a donut; several give you concentric rings, like the layers of a target. Run the rings as a hierarchy (selecting an outer segment selects its whole path) or as independent layers. Vintage, badge-inspired palettes.",
  "type": "visualization",
  "version": "1.0.0",
  "icon": "pie-chart",
  "author": "Benjamin Rode",
  "license": "MIT",
  "keywords": "qlik-visualization-extension",
  "dependencies": {
    "qlik-sense": ">=3.0.x"
  }
}
